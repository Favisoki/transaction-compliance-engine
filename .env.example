# Copy to .env for local (non-Docker) development: cp .env.example .env

APP_NAME="Transaction Compliance Engine"
ENVIRONMENT=local
LOG_LEVEL=INFO

# Create tables on API startup. Fine for local development; use migrations in production.
AUTO_CREATE_TABLES=true

DATABASE_URL=postgresql+psycopg2://compliance:compliance@localhost:5432/compliance
REDIS_URL=redis://localhost:6379/0

# Optional overrides. Default to REDIS_URL when unset.
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/1
# Defaults to solo on macOS and prefork on Linux. Override to force a pool.
# CELERY_WORKER_POOL=prefork

# Compliance rule configuration
VELOCITY_WINDOW_SECONDS=300
VELOCITY_MAX_TRANSACTIONS=3
# Comma-separated ISO-3166 alpha-2 codes.
HIGH_RISK_COUNTRIES=KP,IR,SY,CU,SD,MM,BY
LARGE_TRANSACTION_THRESHOLD_USD=10000

# Background delivery recovery
STALE_PENDING_SECONDS=120
STALE_DISPATCH_BATCH_SIZE=100
